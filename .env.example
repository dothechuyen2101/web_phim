# Supabase — pooler Supavisor (Dashboard → Connect). Host trực tiếp db.<ref>.supabase.co chỉ có IPv6.
# Ký tự đặc biệt trong mật khẩu phải mã hóa URL (@ → %40).
# TLS được xác thực đầy đủ với CA chính thức của Supabase trong certs/supabase-ca.crt.
#   - Máy dev / VPS / worker: session mode, cổng 5432.
#   - Vercel (serverless): transaction mode, cổng 6543 — xem mục "Triển khai lên Vercel" trong README.
DATABASE_URL="postgresql://postgres.<project-ref>:<mat-khau>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-ca.crt"
# Kết nối cho Prisma CLI (migrate) và các script quản trị. Bỏ trống thì dùng DATABASE_URL.
# Bắt buộc phải là session mode (5432) nếu DATABASE_URL đang là transaction mode (6543).
# DIRECT_URL="postgresql://postgres.<project-ref>:<mat-khau>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-ca.crt"
# Số kết nối tối đa mỗi tiến trình (pooler giới hạn ~15 kết nối cho cả web + worker)
DB_POOL_MAX=5

# Hoặc Postgres local (docker compose up -d):
# DATABASE_URL="postgresql://phim:phim@localhost:5433/web_phim?schema=public"

# URL công khai của web (dùng cho sitemap, metadata, Open Graph).
# Trên Vercel có thể bỏ trống: tự dùng domain production (*.vercel.app).
SITE_URL="http://localhost:3100"
SITE_NAME="Web Phim"

# Các secret dưới đây tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Khóa ký cookie phiên đăng nhập
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-dai"
# Secret để worker / tick gọi /api/revalidate sau mỗi lần đồng bộ
REVALIDATE_SECRET="thay-bang-chuoi-ngau-nhien-khac"
# Secret để Supabase pg_cron và Vercel Cron gọi /api/cron/tick (chỉ cần khi chạy trên Vercel)
CRON_SECRET="thay-bang-chuoi-ngau-nhien-thu-ba"

# Worker gọi endpoint revalidate của web tại địa chỉ này (trên Vercel không cần)
WEB_INTERNAL_URL="http://localhost:3100"

# Web Push — thông báo tập mới. Tạo bằng: npx web-push generate-vapid-keys (bỏ trống thì tính năng tự ẩn).
# Khóa công khai được nhúng lúc build. Đổi khóa thì mọi thiết bị phải bật lại thông báo.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
