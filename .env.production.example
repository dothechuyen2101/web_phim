# Domain trỏ về VPS (bản ghi A). Caddy dùng để cấp HTTPS.
DOMAIN=phim.example.com
SITE_URL=https://phim.example.com
SITE_NAME="Web Phim"

# Supabase — dùng pooler Supavisor, session mode (cổng 5432). Lấy ở Dashboard → Connect → Session pooler.
# Ký tự đặc biệt trong mật khẩu phải mã hóa URL (ví dụ @ → %40).
# certs/supabase-ca.crt (CA chính thức của Supabase) được copy sẵn vào image để xác thực TLS.
DATABASE_URL=postgresql://postgres.<project-ref>:<mat-khau>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-ca.crt
# Số kết nối DB tối đa mỗi tiến trình (pooler giới hạn ~15 kết nối đồng thời cho cả web + worker)
DB_POOL_MAX=5

# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
REVALIDATE_SECRET=

# Web Push — thông báo tập mới (npx web-push generate-vapid-keys). Bỏ trống thì tính năng tự ẩn.
# Khóa công khai được nhúng lúc build: đổi thì phải build lại (up -d --build).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Domain player được phép nhúng (CSP frame-src), cách nhau bằng dấu cách
EMBED_HOSTS="https://player.phimapi.com https://*.streamc.xyz https://*.streamvsmov.com"
