{
  "name": "web_phim",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "sync": "tsx scripts/sync.ts",
    "worker": "tsx worker/index.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "enqueue": "tsx scripts/enqueue.ts",
    "dev:all": "concurrently -k -n web,worker -c cyan,magenta \"npm:dev\" \"npm:worker\"",
    "merge-duplicates": "tsx scripts/merge-duplicates.ts",
    "setup-cron": "tsx scripts/setup-cron.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bottleneck": "^2.19.5",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "hls.js": "^1.7.4",
    "jose": "^6.2.14",
    "lucide-react": "^1.64.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "prisma": "^7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
